*.iml
.gradle
/local.properties
# Configuracion de Android Studio: es del equipo o maquina de quien abre el
# proyecto, no del proyecto en si. Se excluye por completo en lugar de listar
# archivo por archivo, porque el IDE agrega nombres nuevos en cada version.
/.idea/
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties

# Credenciales y secretos
google-services.json
*.jks
*.keystore
.env
*.log

# Node: la CLI de Supabase vive como dependencia de desarrollo del proyecto.
# package.json y package-lock.json si se versionan: fijan su version.
node_modules/
npm-debug.log*
