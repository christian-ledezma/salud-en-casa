root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{xml,json,yml,yaml,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{kt,kts}]
ktlint_code_style = ktlint_official
max_line_length = 120

# Las funciones componibles se nombran en PascalCase por convencion de Compose.
# Sin esta excepcion, la regla de nomenclatura de ktlint marca cada pantalla y
# cada componente del proyecto.
ktlint_function_naming_ignore_when_annotated_with = Composable
