<?xml version="1.0" encoding="utf-8"?>
<!-- 288 dp is the icon size of the Android 12 system splash, so the mark sits
     where StartupScreen picks it up on every version. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/window_background" />
    <item
        android:width="288dp"
        android:height="288dp"
        android:drawable="@drawable/ic_brand_mark"
        android:gravity="center" />
</layer-list>
