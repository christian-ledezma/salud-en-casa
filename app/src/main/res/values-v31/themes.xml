<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- From Android 12 the system draws its own splash and ignores the window
         background, so it gets the same mark on the same color. -->
    <style name="Theme.SaludEnCasa.Starting">
        <item name="android:windowBackground">@drawable/startup_window</item>
        <item name="android:windowSplashScreenBackground">@color/window_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_brand_mark</item>
    </style>
</resources>
